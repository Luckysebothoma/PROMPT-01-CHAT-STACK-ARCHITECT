{
  "title": "AI Gateway 1 of 10 - Chat Foundation",
  "uid": "ai-gateway-1-of-10-chat",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_http_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_http_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_gateway_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 4,
      "title": "AI Request Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_ai_requests_total[5m])) by (provider, status)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Token Consumption",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_input_tokens_total[5m])) by (provider)",
          "legendFormat": "input {{provider}}"
        },
        {
          "expr": "sum(rate(ai_gateway_output_tokens_total[5m])) by (provider)",
          "legendFormat": "output {{provider}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_cache_hits_total[5m])) / (sum(rate(ai_gateway_cache_hits_total[5m])) + sum(rate(ai_gateway_cache_misses_total[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Provider Request Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_provider_requests_total[5m])) by (provider, model, status)"
        }
      ]
    },
    {
      "id": 8,
      "title": "Provider Error Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_provider_errors_total[5m])) by (provider, status)"
        }
      ]
    },
    {
      "id": 9,
      "title": "Provider Latency (p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_gateway_provider_request_duration_seconds_bucket[5m])) by (le, provider))"
        }
      ]
    },
    {
      "id": 10,
      "title": "Tokens by Provider",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_provider_input_tokens_total[5m])) by (provider)"
        }
      ]
    },
    {
      "id": 11,
      "title": "Tokens by Model",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ai_gateway_provider_output_tokens_total[5m])) by (model)"
        }
      ]
    }
  ]
}
APP_NAME=ai-gateway-1-of-10-chat
APP_ENV=development
LOG_LEVEL=info

API_PORT=4400

POSTGRES_ENABLED=true
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

REDIS_ENABLED=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_DATABASE=0

SHARED_DOCKER_NETWORK=ai-gateway-net

CREATE_NETWORK_IF_MISSING=false

REGISTRY_ENABLED=false
REGISTRY_HOST=
IMAGE_NAME=ai-gateway-1-of-10-chat
IMAGE_TAG=latest

PROMETHEUS_ENABLED=true
PROMETHEUS_URL=

GRAFANA_ENABLED=false
GRAFANA_URL=

HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5

# --- Day 2: AI provider abstraction ---------------------------------------
# No credentials are committed. Fill these only in your local .env file.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Operator-declared models: "model_key:category" comma separated
GROQ_MODELS=

# Configuration placeholders only. No adapter implemented in this iteration.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=
